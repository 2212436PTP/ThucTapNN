# Supabase Configuration for ITC Quality Dashboard
# Lấy thông tin từ Supabase Dashboard: Project Settings -> API

# URL dự án Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Khóa công khai (anon public key) dùng cho Client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Khóa bí mật (service_role secret key) dùng cho Server Route Handlers (tạo/xóa giảng viên, quản lý môn học)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

